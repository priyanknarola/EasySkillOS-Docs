Ref: kai_attachments.student_id > students.id
Ref: ai_usage_cap_policy.updated_by_user_id > users.id
Ref: nl_query_logs.user_id > users.id
Ref: saved_queries.user_id > users.id

// Batches & Sessions
Ref: batches.track_id > tracks.id
Ref: batches.faculty_id > users.id
Ref: batch_enrollments.batch_id > batches.id
Ref: batch_enrollments.enrollment_id > enrollments.id
