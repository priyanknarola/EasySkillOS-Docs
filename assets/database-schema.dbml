  behavioural_questions json
  gap_questions json
  questions_to_ask_interviewer json
  opening_pitch text
  red_flags_to_avoid json
  confidence_tips json
  self_intro_confident text
  self_intro_humble text
  self_intro_storytelling text
  salary_advice json
  readiness_score integer [note: "0-100"]
  last_practiced_at timestamptz
