  dimension_scores json [note: "{skill,experience,academic,location,salary} 0-100"]
  match_reasoning text
  skill_gap_report json
  tailored_resume_url varchar(500)
  generated_at timestamptz
  is_ai_generated boolean [default: true]
  created_at timestamptz
}

Table generated_resumes {
  id varchar(36) [pk]
  student_id varchar(36) [not null]
  target_role varchar(200) [not null]
  target_company_type varchar(100)
  style varchar(30) [not null, default: "modern"]
