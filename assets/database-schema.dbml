  skills_demonstrated json
  artefact_url varchar(500)
  public_url varchar(500)
  employer_visible boolean [default: true]
  created_at timestamptz
  updated_at timestamptz
}

Table employer_interactions {
  id varchar(36) [pk]
  employer_id varchar(36) [not null]
  logged_by varchar(36)
  type varchar(20) [not null, note: "call|email|whatsapp|meeting"]
