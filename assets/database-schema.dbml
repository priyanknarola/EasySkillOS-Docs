  sitting_id varchar(36) [note: "Groups all rows from a single /start to /submit-answer flow"]
  question_index integer [not null]
  question_text text [not null]
  question_type varchar(20) [not null, note: "technical|behavioural|gap"]
  student_answer text [not null]
  score integer [note: "0-100"]
  what_was_good text
  what_was_missing text
  delivery_feedback text
  improved_answer_framework text
  interviewer_reaction varchar(20) [note: "positive|neutral|concerned"]
  follow_up_question text
