  resume_json json [not null, note: "{name,email,city,summary,skills[],experience[],education,ats_issues[],ats_suggestions[]}"]
  ats_score integer [note: "0-100"]
  is_ai_generated boolean [not null, default: true]
  public_slug varchar(64) [unique, note: "NULL when private"]
  is_public boolean [not null, default: false]
  created_at timestamptz
  updated_at timestamptz
}

Table student_portfolios {
  id varchar(36) [pk]
  student_id varchar(36) [not null]
  track_id varchar(100)
  project_title varchar(200) [not null]
