  approved_by varchar(36)
  status varchar(20) [not null, default: "applied", note: "applied|approved|rejected"]
  created_at timestamptz
  updated_at timestamptz
}

Table refunds {
  id varchar(36) [pk]
  enrollment_id varchar(36) [not null]
  amount numeric(10,2) [not null]
  approved_amount numeric(10,2)
  reason text
  refund_type varchar(30) [not null, default: "standard", note: "standard|satisfaction_7day|job_guarantee"]
  status varchar(20) [not null, default: "requested", note: "requested|under_review|approved|rejected|processing|processed"]
  reviewer_note text
  reviewed_by varchar(36)
  reviewed_at timestamptz
  processed_by varchar(36)
  processed_at timestamptz
  razorpay_refund_id varchar(100)
  payment_mode varchar(20) [note: "razorpay|cash|bank_transfer"]
  created_at timestamptz
  updated_at timestamptz
}

Table revenue_forecasts {
  id varchar(36) [pk]
  generated_at timestamptz [not null]
  period_days integer [not null, default: 90]
  centre varchar(20) [note: "null = all centres"]
  forecast_data json [not null, note: "daily_forecast + summary JSON"]
  model_used varchar(50) [not null, default: "rule_based"]
  is_ai_generated boolean [not null, default: false]
  created_at timestamptz
}

Table document_sequences {
  id varchar(36) [pk]
  centre_code varchar(10) [not null, note: "ADJ|VES|BHE|ONL|ALL"]
  year integer [not null]
  doc_type varchar(10) [not null, note: "INV|REC|EMI"]
  last_sequence integer [not null, default: 0]
  created_at timestamptz
  updated_at timestamptz
}


// ============================================================
// GROUP 7: Placement
// ============================================================

Table employers {
  id varchar(36) [pk]
  name varchar(200) [not null]
  website varchar(500)
  industry varchar(100)
  city varchar(100)
  contact_name varchar(100)
  contact_email varchar(200)
  contact_phone varchar(15)
  logo_url varchar(500)
  description text
  about_company text
  company_size varchar(50) [note: "1-10|11-50|51-200|201-500|500+"]
  linkedin_url varchar(500)
  hiring_contact_name varchar(100)
  hiring_contact_phone varchar(15)
  hiring_since date
  total_hires_from_easyskill integer [default: 0]
  rating float [note: "Internal EasySkill rating 1-5"]
  rating_note text
  verification_date date
  verification_status varchar(30) [not null, default: "pending_verification", note: "pending_verification|verified|rejected|suspended"]
  user_id varchar(36) [note: "Linked User for employer portal login"]
  verified boolean [default: false]
  onboarded_at timestamptz
  onboarded_by varchar(36)
  created_at timestamptz
  updated_at timestamptz
}

Table job_listings {
  id varchar(36) [pk]
  employer_id varchar(36) [not null]
  title varchar(200) [not null]
  description text
  requirements json
  skills_required json
  salary_min integer
  salary_max integer
  location varchar(100)
  remote_ok boolean [default: false]
  work_type varchar(20) [default: "on_site", note: "remote|hybrid|on_site"]
  responsibilities json
  skills_preferred json
  experience_min_years float [default: 0.0]
  experience_max_years float
  employment_type varchar(20) [default: "full_time", note: "full_time|part_time|contract|internship"]
  openings_count integer [default: 1]
  application_deadline date
  source varchar(30) [default: "direct", note: "direct|justnaukri|other"]
  status varchar(20) [not null, default: "open", note: "open|closed"]
  expires_at timestamptz
  created_at timestamptz
  updated_at timestamptz
}

Table job_applications {
  id varchar(36) [pk]
  student_id varchar(36) [not null]
  job_listing_id varchar(36) [not null]
  status varchar(20) [not null, default: "pending", note: "pending|interviewing|offered|rejected|accepted"]
  applied_at timestamptz
  resume_url varchar(500)
  resume_id varchar(36) [note: "FK generated_resumes.id; SET NULL on delete"]
  cover_letter_ai text
  interview_date timestamptz
  outcome varchar(20)
  notes text
  created_at timestamptz
  updated_at timestamptz
}

Table job_matches {
  id varchar(36) [pk]
  student_id varchar(36) [not null]
  job_listing_id varchar(36) [not null]
  match_score integer [not null, note: "0-100"]
