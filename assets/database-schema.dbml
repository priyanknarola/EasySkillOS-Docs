  is_ai_generated boolean [default: true]
  created_at timestamptz
  updated_at timestamptz
}

Table placement_outcomes {
  id varchar(36) [pk]
  student_id varchar(36) [not null]
  enrollment_id varchar(36)
  job_listing_id varchar(36)
  employer_id varchar(36)
  application_id varchar(36)
  company_name varchar(200) [not null]
  role_title varchar(200) [not null]
  salary_inr integer [not null, note: "Monthly salary in INR"]
  joining_date date [not null]
  work_type varchar(20) [not null, default: "on_site"]
  location varchar(200)
  placement_type varchar(20) [not null, default: "portal", note: "direct|referral|portal|campus|other"]
  notes text
  offer_letter_url varchar(500)
  days_to_placement integer
  verified boolean [not null, default: false]
  verified_by varchar(36)
  verified_at timestamptz
  verification_note text
  success_story_id varchar(36)
  job_guarantee_fulfilled boolean [not null, default: false]
  created_at timestamptz
  updated_at timestamptz
}

Table success_stories {
  id varchar(36) [pk]
  placement_outcome_id varchar(36) [not null, unique]
  student_id varchar(36) [not null]
  story_text text
  tagline varchar(300)
  quote text
  is_ai_generated boolean [not null, default: true]
  status varchar(20) [not null, default: "draft", note: "draft|pending_review|published|rejected"]
  approved_by varchar(36)
  approved_at timestamptz
  published_at timestamptz
  edited_story_text text
  edited_tagline varchar(300)
  edited_quote text
  created_at timestamptz
  updated_at timestamptz
}

Table justnaukri_sync {
  id varchar(36) [pk]
  student_id varchar(36) [not null, unique]
  justnaukri_candidate_id varchar(100)
  sync_status varchar(20) [not null, default: "pending", note: "pending|synced|failed|not_eligible"]
  last_profile_update_at timestamptz
  synced_at timestamptz
  last_error text
  created_at timestamptz
  updated_at timestamptz
}

Table jobs {
  id varchar(36) [pk, note: "Legacy jobs table — see job_listings for placement"]
  employer_id varchar(36) [not null]
  title varchar(200) [not null]
  description text
  company_name varchar(200)
  location varchar(100)
  job_type varchar(30)
  salary_range varchar(100)
  required_skills json
  required_tracks json
  min_score integer [default: 0]
  applications_count integer [default: 0]
  status varchar(20) [default: "active"]
  created_at timestamptz
}


// ============================================================
// GROUP 8: Community
// ============================================================

Table community_posts {
  id varchar(36) [pk]
  user_id varchar(36) [not null]
  title varchar(300) [not null]
  content text [not null]
  category varchar(50) [default: "general"]
  tag varchar(60) [note: "Topic chip e.g. Meta Ads, Copywriting"]
  is_solved boolean [not null, default: false]
  vote_count integer [not null, default: 0, note: "Cached net score up-down"]
  likes_count integer [default: 0]
  replies_count integer [default: 0]
  is_pinned boolean [default: false]
  created_at timestamptz
}

Table community_replies {
  id varchar(36) [pk]
  post_id varchar(36) [not null]
  user_id varchar(36) [not null]
  content text [not null]
  likes_count integer [default: 0]
  is_accepted boolean [not null, default: false, note: "Original poster marks as accepted answer"]
  created_at timestamptz
}

Table community_post_votes {
  id varchar(36) [pk]
  post_id varchar(36) [not null, note: "CASCADE delete"]
  user_id varchar(36) [not null, note: "CASCADE delete"]
  direction varchar(4) [not null, note: "up|down"]
  created_at timestamptz
  updated_at timestamptz
}

Table study_buddy_opt_ins {
  id varchar(36) [pk]
  user_id varchar(36) [not null, unique, note: "CASCADE delete"]
  track_id varchar(100)
  preferred_study_time varchar(60)
  timezone_offset integer [default: 330, note: "Minutes from UTC; default IST"]
  city varchar(100)
  is_active boolean [not null, default: true]
  created_at timestamptz
  updated_at timestamptz
}

Table study_groups {
  id varchar(36) [pk]
  name varchar(200) [not null]
  track_id varchar(100)
  created_by varchar(36) [not null]
  max_members integer [default: 10]
  member_count integer [default: 1]
  members json
  is_active boolean [default: true]
  created_at timestamptz
}

Table support_tickets {
  id varchar(36) [pk]
  user_id varchar(36) [not null]
  subject varchar(200) [not null]
  message text [not null]
  category varchar(50) [default: "general"]
  status varchar(20) [default: "open", note: "open|in_progress|resolved|closed"]
  assigned_to varchar(36)
  resolution text
  created_at timestamptz
  updated_at timestamptz
}

Table support_ticket_messages {
  id varchar(36) [pk]
  ticket_id varchar(36) [not null, note: "CASCADE delete"]
  sender_id varchar(36) [not null]
  body text [not null]
  created_at timestamptz
}


// ============================================================
// GROUP 9: Communication
// ============================================================

Table notifications {
  id varchar(36) [pk]
  user_id varchar(36) [not null]
  type varchar(30) [not null]
  title varchar(200) [not null]
  message text
  action_url varchar(300)
  is_read boolean [default: false]
  created_at timestamptz
}

Table notification_configs {
  id varchar(36) [pk]
  event_name varchar(100) [not null, unique]
  description text
  category varchar(50) [not null, default: "system"]
  channels_enabled json [not null, note: "{sse: bool, whatsapp: bool, email: bool}"]
  recipient_roles json [not null]
  template_whatsapp text
  template_email_subject varchar(500)
  cooldown_minutes integer [not null, default: 0]
  is_enabled boolean [not null, default: true]
  updated_by varchar(100)
  created_at timestamptz
  updated_at timestamptz
}

Table broadcast_audience_groups {
  id varchar(36) [pk]
  name varchar(100) [not null]
  description text
  filter_type varchar(10) [not null, default: "smart", note: "smart|manual"]
  filters json [not null, note: '{"status":[],"centre":"vesu","source":"meta_ad","ai_temperature":"hot","score_min":50}']
  lead_ids json [not null, note: "Array of lead UUIDs for manual groups"]
  recipient_count integer [not null, default: 0]
  created_by varchar(36) [not null]
  is_shared boolean [not null, default: false]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table whatsapp_templates {
  id varchar(36) [pk]
  meta_template_id varchar(64) [note: "null while LOCAL_DRAFT"]
  name varchar(512) [not null]
  language varchar(16) [not null, default: "en"]
  category varchar(32) [not null, default: "MARKETING", note: "MARKETING|UTILITY|AUTHENTICATION"]
  status varchar(32) [not null, default: "LOCAL_DRAFT", note: "LOCAL_DRAFT|PENDING|APPROVED|REJECTED|FLAGGED|PAUSED|DISABLED|DELETED_REMOTE"]
  components_json json [not null, note: "Meta components array [{type:BODY,text:...}]"]
  variables_mapping json [note: '{"1":"lead.name","2":"lead.course_interest"}']
  quality_score varchar(16) [note: "GREEN|YELLOW|RED|UNKNOWN"]
  rejection_reason text
  last_synced_at timestamptz
  created_by varchar(36)
  created_at timestamptz
  updated_at timestamptz
  deleted_at timestamptz [note: "Soft delete"]
}

Table whatsapp_template_events {
  id varchar(36) [pk]
  template_id varchar(36) [not null, note: "CASCADE delete"]
  event varchar(32) [not null, note: "APPROVED|REJECTED|FLAGGED|PAUSED|DISABLED|SYNCED|CREATED|DELETED"]
  reason text
  payload_json json [note: "Raw Meta webhook payload for forensic replay"]
  received_at timestamptz [not null]
}

Table whatsapp_logs {
  id varchar(36) [pk]
  phone varchar(15) [not null]
  template varchar(100)
  message text
  direction varchar(10) [default: "outbound"]
  status varchar(20) [default: "sent"]
  sent_by varchar(36)
  error_message text
  created_at timestamptz
}

Table batch_communications {
  id varchar(36) [pk]
  batch_id varchar(36) [not null]
  sent_by varchar(36) [not null]
  type varchar(30) [not null, note: "announcement|reminder|resource_share|individual|homework|motivate"]
  channel varchar(20) [not null, default: "whatsapp", note: "whatsapp|in_app|both"]
  message text [not null]
  attachment_url varchar(500)
  target_student_id varchar(36)
  resource_id varchar(36)
  session_id varchar(36)
  recipient_count integer [not null, default: 0]
  delivered_count integer [not null, default: 0]
  read_count integer [not null, default: 0]
  scheduled_at timestamptz
  sent_at timestamptz [not null]
  is_sent boolean [not null, default: true]
  created_at timestamptz
}

Table batch_communication_recipients {
  id varchar(36) [pk]
  communication_id varchar(36) [not null]
  student_id varchar(36)
  user_id varchar(36)
  name varchar(200)
  phone varchar(20)
  recipient_type varchar(20) [not null, default: "student", note: "student|parent"]
  delivered boolean [not null, default: false]
  read boolean [not null, default: false]
  delivered_at timestamptz
  created_at timestamptz
}

Table faculty_student_flags {
  id varchar(36) [pk]
  student_id varchar(36) [not null]
  batch_id varchar(36)
  flagged_by varchar(36) [not null]
  reason text [not null]
  urgency varchar(20) [not null, default: "normal", note: "normal|urgent"]
  resolved boolean [not null, default: false]
  resolution_note text
  resolved_at timestamptz
  created_at timestamptz
}


// ============================================================
// GROUP 10: AI & Config
// ============================================================

Table kai_conversations {
  id varchar(36) [pk]
  conversation_id varchar(36) [not null, note: "Groups messages into a session"]
  student_id varchar(36) [not null]
  role varchar(10) [not null, note: "user|assistant"]
  content text [not null]
  retrieved_chunks json
  attachments json
  suggested_followups json
  tokens_used integer [default: 0]
  latency_ms integer [default: 0]
  escalation_triggered boolean [default: false]
  task_id varchar(36) [note: "Populated for task workspace AI Help sessions"]
  title varchar(200) [note: "Auto-derived for task-help; null for ad-hoc chats"]
  created_at timestamptz
}

Table kai_attachments {
  id varchar(36) [pk]
  conversation_id varchar(36)
  message_id varchar(36) [note: "FK kai_conversations.id"]
  student_id varchar(36) [not null]
  filename varchar(255) [not null]
  file_url varchar(500) [not null]
  content_type varchar(100) [not null]
  size_bytes integer [not null]
  file_type varchar(20) [not null, note: "image|document"]
  extracted_text text
  created_at timestamptz
}

Table knowledge_chunks {
  id varchar(36) [pk]
  source_type varchar(30) [not null, note: "track_content|module_content|faq|placement_story|industry_guide|tool_tutorial|job_market_data"]
  source_id varchar(36)
  title varchar(500) [not null]
  content text [not null]
  embedding json [note: "1536-dim pgvector embedding (JSON in SQLite dev)"]
  language varchar(5) [not null, default: "en"]
  track_id varchar(100)
  created_at timestamptz
  updated_at timestamptz
}

Table ai_usage_cap_policy {
  id integer [pk]
  name varchar(64) [not null, unique, default: "default"]
  daily_credit_cap integer [not null, default: 200]
  weekly_credit_cap integer [not null, default: 1000]
  credit_unit_inr numeric(8,4) [not null, default: 0.10]
  warning_threshold_pct integer [not null, default: 80]
  feature_costs json [not null, note: "{kai_chat:1,mentor_chat:1,mock_interview_answer:1,resume_generation:10,tailored_resume:10}"]
  is_active boolean [not null, default: true]
  updated_by_user_id varchar(36)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table feature_flags {
  id varchar(36) [pk]
  name varchar(100) [not null, unique]
  display_name varchar(200) [not null]
  description text
  category varchar(50) [not null, default: "ai", note: "ai|integrations|student_portal|hr|experimental"]
  enabled_globally boolean [not null, default: true]
  enabled_per_centre json [not null, note: '{"adajan":true,"vesu":false}']
  enabled_per_role json [not null, note: '{"super_admin":true,"counselor":false}']
  daily_cost_limit_inr float [not null, default: 0.0]
  daily_cost_used_inr float [not null, default: 0.0]
  monthly_cost_limit_inr float [not null, default: 0.0]
  monthly_cost_used_inr float [not null, default: 0.0]
  auto_disable_on_limit boolean [not null, default: false]
  last_toggled_at timestamptz
  last_toggled_by varchar(100)
  toggle_count integer [not null, default: 0]
  created_at timestamptz
  updated_at timestamptz
}

Table ai_model_configs {
  id varchar(36) [pk]
  feature_name varchar(100) [not null, unique, note: "e.g. resume_screener|cohort_analysis|counselor_insights"]
  display_name varchar(200) [not null]
  model_id varchar(100) [not null, default: "gpt-4o-mini"]
  temperature float [not null, default: 0.4]
  max_tokens integer [not null, default: 1500]
  top_p float [not null, default: 1.0]
  cost_per_1k_tokens_inr float [not null, default: 0.12]
  notes text
  updated_by varchar(100)
  created_at timestamptz
  updated_at timestamptz
}

Table ai_system_prompts {
  id varchar(36) [pk]
  feature_name varchar(100) [not null]
  version integer [not null, default: 1]
  prompt_text text [not null]
  is_active boolean [not null, default: false]
  test_input text
  test_output text
  tested_at timestamptz
  created_by varchar(100)
  change_notes text
  created_at timestamptz
}

Table nl_query_logs {
  id varchar(36) [pk]
  user_id varchar(36) [not null]
  question text [not null]
  interpreted_as text
  chart_type varchar(20)
  row_count integer
  execution_time_ms integer
  success boolean [not null, default: true]
  error_reason varchar(200)
  intent_json json
  centre varchar(100)
  executed_at timestamptz [not null]
  created_at timestamptz
}

Table saved_queries {
  id varchar(36) [pk]
  user_id varchar(36) [not null]
  name varchar(200) [not null]
  description text
  question text [not null]
  category varchar(50) [note: "revenue|leads|students|placement|hr|custom"]
  intent_json json
  last_run_at timestamptz
  run_count integer [not null, default: 0]
  created_at timestamptz
}

Table centre_configs {
  id varchar(36) [pk]
  name varchar(50) [not null, unique, note: "adajan|vesu|bhestan"]
  display_name varchar(200) [not null]
  address text
  city varchar(100) [default: "Surat"]
  state varchar(100) [default: "Gujarat"]
  pincode varchar(10)
  phone varchar(20)
  whatsapp_number varchar(20)
  email varchar(200)
  google_maps_url text
  operating_hours json [not null, note: "{day:{open:HH:MM,close:HH:MM,is_closed:bool}}"]
  capacity integer [not null, default: 100]
  centre_manager_id varchar(36)
  centre_manager_name varchar(200)
  is_active boolean [not null, default: true]
  late_arrival_tolerance_minutes integer [not null, default: 15]
  qr_attendance_enabled boolean [not null, default: true]
  local_pricing_overrides json [not null, note: "{track_id:{price:int,reason:str}}"]
  updated_by varchar(100)
  created_at timestamptz
  updated_at timestamptz
}

Table pricing_tiers {
  id varchar(36) [pk]
  name varchar(200) [not null]
  description text
  discount_pct float [not null, default: 0.0, note: "Negative = premium"]
  eligibility_criteria json [not null]
  is_active boolean [not null, default: true]
  created_by varchar(100)
  created_at timestamptz
  updated_at timestamptz
}

Table global_settings {
  id integer [pk, default: 1, note: "Singleton — always id=1"]
  pricing json [not null]
  gst json [not null]
  updated_by varchar(100)
  updated_at timestamptz
}

Table brand_configs {
  id integer [pk, default: 1, note: "Singleton — always id=1"]
  academy_name varchar(300) [not null, default: "EasySkill Career Academy"]
  tagline varchar(500)
  logo_url text
  primary_color varchar(10) [not null, default: "4F46E5"]
  secondary_color varchar(10) [not null, default: "059669"]
  founder_name varchar(200) [not null, default: "Smit Savani"]
  founder_title varchar(200) [not null]
  founder_signature_url text
  contact_email varchar(200)
  contact_phone varchar(20)
  address_line1 text
  address_line2 text
  city varchar(100) [default: "Surat"]
  state varchar(100) [default: "Gujarat"]
  pincode varchar(10)
  website_url varchar(300)
  gstin varchar(20)
  bank_name varchar(200)
  bank_account_number varchar(50)
  bank_ifsc varchar(20)
  updated_by varchar(100)
  updated_at timestamptz
}

Table system_announcements {
  id varchar(36) [pk]
  title varchar(300) [not null]
  message text [not null]
  type varchar(20) [not null, default: "info", note: "info|warning|maintenance"]
  target_roles json [not null, note: "[] = all roles"]
  show_from timestamptz [not null]
  show_until timestamptz
  is_dismissable boolean [not null, default: true]
  is_active boolean [not null, default: true]
  created_by varchar(100)
  created_at timestamptz
}

Table platform_settings {
  key varchar(100) [pk]
  value text [not null]
  updated_at timestamptz
  updated_by varchar(36)
}

// ============================================================
// GROUP 11: Batches & Sessions (Faculty)
// ============================================================

Table batches {
  id varchar(36) [pk]
  track_id varchar(100) [not null]
  faculty_id varchar(36)
  name varchar(200) [not null]
  centre varchar(20) [note: "adajan|vesu|bhestan|online"]
  start_date date
  end_date date
  max_students integer
  enrolled_count integer [default: 0]
  status varchar(20) [not null, default: "planning", note: "planning|open|running|completed"]
  schedule json [note: '[{"day":"Mon","time":"10:00-12:00"}]']
  delivery_mode varchar(20) [default: "in_person"]
  zoom_link varchar(500)
  whatsapp_group_link varchar(500)
  cohort_tag varchar(100)
  notes text
  timing varchar(50)
  description text
  is_active boolean [default: true]
  created_at timestamptz
  updated_at timestamptz
}

Table batch_enrollments {
  id varchar(36) [pk]
  batch_id varchar(36) [not null]
  enrollment_id varchar(36) [not null]
  joined_at timestamptz
  created_at timestamptz
}

Table sessions {
  id varchar(36) [pk]
  batch_id varchar(36) [not null]
  title varchar(200) [not null]
  session_number integer
  module_id varchar(36)
  scheduled_at timestamptz [not null]
  duration_minutes integer [default: 120]
  zoom_link varchar(500)
  recording_url varchar(500)
  faculty_notes text
  actual_start_at timestamptz
  actual_end_at timestamptz
  attendance_taken boolean [not null, default: false]
  session_plan json [note: "Agenda, objectives, resources_to_cover, homework"]
  post_session_notes json [note: "what_went_well, difficult_topics, students_needing_support"]
  ai_session_summary text
  status varchar(20) [not null, default: "scheduled", note: "scheduled|in_progress|completed|cancelled"]
  notes text
  created_at timestamptz
  updated_at timestamptz
}

Table session_attendance {
  id varchar(36) [pk]
  session_id varchar(36) [not null]
  student_id varchar(36) [not null]
  batch_id varchar(36)
  status varchar(20) [not null, default: "present", note: "present|absent|late|excused"]
  marked_by varchar(36)
  marked_at timestamptz
  parent_excused boolean [not null, default: false]
  notes text
  created_at timestamptz
}

Table live_sessions {
  id varchar(36) [pk]
  title varchar(200) [not null]
  description text
  track_id varchar(100)
  batch_id varchar(36)
  host_name varchar(100)
  scheduled_at timestamptz [not null]
  duration_minutes integer [default: 60]
  meeting_url varchar(500)
  recording_url varchar(500)
  status varchar(20) [default: "scheduled"]
  attendee_count integer [default: 0]
  created_at timestamptz
}

// ============================================================
// GROUP 12: HR
// ============================================================

Table staff {
  id varchar(36) [pk]
  user_id varchar(36) [not null, unique]
  department varchar(50) [note: "counseling|academics|operations|marketing|tech"]
  designation varchar(100)
