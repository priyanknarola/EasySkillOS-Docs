  status varchar(20) [not null, default: "upcoming", note: "upcoming|due|paid|overdue|failed"]
  razorpay_payment_id varchar(100)
  receipt_url varchar(500)
  created_at timestamptz
}

Table invoices {
  id varchar(36) [pk]
  enrollment_id varchar(36) [not null]
  invoice_number varchar(50) [not null, unique]
  invoice_type varchar(20) [not null, default: "standard", note: "standard|gst"]
  amount numeric(10,2) [not null]
  gst_amount numeric(10,2)
  total_amount numeric(10,2)
  status varchar(20) [not null, default: "generated", note: "generated|sent|paid|overdue"]
  pdf_url varchar(500)
  sent_at timestamptz
  generated_by varchar(36)
  created_at timestamptz
  updated_at timestamptz
}

Table coupons {
  id varchar(36) [pk]
  code varchar(50) [not null, unique]
  discount_type varchar(10) [default: "percent", note: "percent|flat"]
  discount_value integer [not null]
