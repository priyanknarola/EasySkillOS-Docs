// ============================================================
// EasySkillOS — Complete DBML Schema
// Generated from SQLAlchemy models (EasyskillOS-dev-one)
// ============================================================


// ============================================================
// GROUP 1: Auth & Users
// ============================================================

Table users {
  id varchar(36) [pk, note: "UUID primary key"]
  phone varchar(15) [not null, unique, note: "Login credential"]
  email varchar(255) [unique, note: "Optional email"]
  password_hash varchar(255) [note: "bcrypt hash; null for OTP-only users"]
  role varchar(20) [not null, default: "student", note: "student|counselor|admin|super_admin|faculty|hr|finance|placement|employer|parent|reviewer|partner|college|alumni|recruiter|corporate"]
  centre varchar(20) [default: "online", note: "adajan|vesu|bhestan|online"]
  is_active boolean [default: true]
  is_deleted boolean [default: false, note: "DPDP Act compliance soft delete"]
  deleted_at timestamptz
  is_hidden_from_staff_list boolean [not null, default: false]
  last_login_at timestamptz
  permissions json [note: "NULL = inherit role default; list of resource.action strings"]
  manager_id varchar(36) [note: "Self-FK for manager hierarchy; NULL = top-level"]
  is_2fa_enabled boolean [not null, default: false]
  totp_secret_encrypted text [note: "Fernet-wrapped base32 TOTP secret"]
  two_factor_method varchar(16) [note: "totp | NULL"]
  two_factor_enabled_at timestamptz
  two_factor_reset_at timestamptz
  created_at timestamptz
  updated_at timestamptz
}

Table user_backup_codes {
  id varchar(36) [pk]
  user_id varchar(36) [not null, note: "FK users.id CASCADE"]
  code_hash varchar(255) [not null, note: "bcrypt hash of one-time recovery code"]
  batch_id varchar(36) [not null, note: "Invalidates full set on regeneration"]
  used_at timestamptz
  created_at timestamptz [not null]
}

Table profiles {
  id varchar(36) [pk]
  user_id varchar(36) [not null, unique]
  full_name varchar(100) [not null]
  avatar_initials varchar(5)
  avatar_url varchar(500)
  city varchar(50)
  state varchar(50)
  education varchar(50)
  situation varchar(30)
  goal varchar(30)
  language_pref varchar(5) [default: "en"]
  onboarding_completed boolean [default: false]
  referral_code varchar(20) [unique]
  referred_by varchar(20)
  bio text
  linkedin_url varchar(300)
  telegram_username varchar(64)
  telegram_chat_id bigint [unique, note: "Telegram chat id for DM alerts"]
  portfolio_visible boolean [default: true]
  notification_preferences json [note: "6 toggle keys; see DEFAULT_NOTIFICATION_PREFERENCES"]
  public_slug varchar(80) [unique, note: "https://easyskill.in/portfolio/{slug}"]
  public_slug_custom boolean [not null, default: false]
  created_at timestamptz
  updated_at timestamptz
}

Table api_keys {
  id varchar(36) [pk]
  name varchar(100) [not null, note: "Human-readable label e.g. 'n8n WhatsApp Bot'"]
  key_prefix varchar(20) [not null, note: "First 16 chars; safe to display/log"]
  key_hash varchar(255) [not null, note: "bcrypt hash; plaintext never stored"]
  scope varchar(50) [not null, default: "leads:write"]
  created_by_id varchar(36) [not null]
  created_at timestamptz [not null]
  last_used_at timestamptz
  last_used_ip varchar(45)
  revoked_at timestamptz
  is_active boolean [not null, default: true]
}

Table audit_logs {
  id varchar(36) [pk]
  user_id varchar(36) [note: "Nullable — system actions may not have a user"]
  action varchar(100) [not null]
  resource varchar(100)
  resource_type varchar(50)
  resource_id varchar(100)
  old_value json
  new_value json
  details json
  extra_data json
  ip_address varchar(45)
  user_agent varchar(200)
  created_at timestamptz
}

Table active_sessions {
  id varchar(36) [pk]
  user_id varchar(36) [not null]
  jwt_jti varchar(36) [not null, unique, note: "JWT ID for blacklist checks"]
  device_info json [not null, note: "{user_agent, os, browser, ip_address}"]
  ip_address varchar(45)
  is_active boolean [not null, default: true]
  created_at timestamptz
  last_active_at timestamptz [not null]
}

Table security_events {
  id varchar(36) [pk]
  event_type varchar(50) [not null, note: "failed_login|suspicious_ip|brute_force_detected|..."]
  user_id varchar(36)
  ip_address varchar(45)
  user_agent text
  metadata json [not null]
  severity varchar(20) [not null, default: "low", note: "low|medium|high|critical"]
  resolved boolean [not null, default: false]
  resolved_by varchar(100)
  resolved_at timestamptz
  resolution_note text
  created_at timestamptz
}

Table erasure_requests {
  id varchar(36) [pk, note: "DPDP Act 2023 Right to Erasure"]
  user_id varchar(36) [not null]
  user_email varchar(300)
  user_name varchar(300)
  reason text [not null]
  status varchar(20) [not null, default: "pending", note: "pending|approved|rejected|completed"]
  reviewed_by varchar(100)
  reviewed_at timestamptz
  rejection_reason text
  erasure_completed_at timestamptz
  retained_record_ids json [not null, note: "Records under legal hold"]
  created_at timestamptz
}


// ============================================================
// GROUP 2: CRM
// ============================================================

Table leads {
  id varchar(36) [pk]
  phone varchar(15) [not null, unique]
  alternate_phone varchar(15) [note: "Alternative / guardian contact"]
  email varchar(200)
  name varchar(100) [not null]
  source varchar(30) [not null, default: "organic", note: "meta_ad|google_ad|walkin|referral|whatsapp|organic|ctwa|discover10x"]
  status varchar(30) [not null, default: "new", note: "new|contacted|interested|visit_scheduled|center_visited|demo_scheduled|seat_reserved|admission_done|lost|dormant"]
  centre varchar(20) [note: "adajan|vesu|bhestan|remote|any"]
  assigned_counselor_id varchar(36)
  assigned_at timestamptz [note: "Set on counselor change; drives stale-lead alerts"]
  lead_partner_id varchar(36) [note: "Original sourcing counselor; stays on reassignment"]
  interested_track_id varchar(100)
  ai_score integer [note: "0-100 AI lead score"]
  ai_temperature varchar(10) [note: "hot|warm|cold|frozen"]
  ai_next_action text
  ai_call_script text
  ai_sentiment varchar(15) [default: "unknown", note: "positive|neutral|negative|unknown"]
  city varchar(100)
  state varchar(100)
  area varchar(120) [note: "Granular locality e.g. Adajan Char Rasta"]
  age integer
  qualification varchar(200)
  employment varchar(80) [note: "Free-text occupation (legacy enum: student|employed|unemployed|freelancer)"]
  budget integer [note: "Budget in INR"]
  utm_source varchar(100)
  utm_medium varchar(100)
  utm_campaign varchar(100)
  utm_content varchar(100)
  meta_lead_id varchar(100) [unique]
  discover10x_report_id varchar(100)
  religion varchar(20) [note: "hindu|muslim|sikh|christian|jain|other"]
  preferred_call_slot varchar(50)
  tags json
  message text [note: "Backward compat: initial message"]
  course_interest varchar(100) [note: "Backward compat"]
  notes text
  call_count integer [default: 0]
  last_contacted_at timestamptz
  next_followup_at timestamptz
  enrolled_at timestamptz
  lost_reason varchar(200)
  last_stale_alert_at timestamptz
  last_stale_alert_tier smallint
  last_followup_alert_at timestamptz
  last_followup_alert_tier smallint
  stage_entered_at timestamptz
  previous_stage varchar(30)
  stage_change_count integer [not null, default: 0]
  last_stage_change_at timestamptz
  stale_days integer [note: "Days since stage_entered_at; refreshed nightly"]
  won_at timestamptz
  first_response_at timestamptz
  first_counselor_contact_at timestamptz
  followup_due_at timestamptz
  followup_reason_category varchar(30) [note: "exam_over|payday|parent_discussion|budget_ready|course_starts|manual_reminder|custom"]
  followup_reason_note text
  followup_source varchar(20) [note: "ai_extracted|counselor_manual|system_auto"]
  followup_set_at timestamptz
  followup_snooze_count integer [not null, default: 0]
  ai_recommended_stage varchar(40)
  ai_recommended_stage_reason text
  ai_recommended_stage_confidence float
  ai_recommended_stage_at timestamptz
  ai_recommendation_source varchar(30) [note: "rule|signal|llm|hybrid|claude_deep_analysis_v1"]
  ai_recommendation_accepted_at timestamptz
  ai_recommendation_overridden_at timestamptz
  buyer_persona varchar(25)
  primary_objection varchar(25)
  objection_history json
  engagement_state varchar(15)
  decision_maker varchar(15)
  primary_motivation varchar(80)
  parents_phone varchar(15)
  preferred_language_text varchar(15)
  financial_signal varchar(20)
  urgency_signal varchar(15)
  odoo_lead_id varchar(36)
  source_system varchar(20)
  original_stage varchar(40)
  duplicate_group_id varchar(36)
  odoo_probability float
  dob date [note: "Date of birth from offline inquiry form"]
  school_or_college varchar(200)
  address text
  career_start_timeline varchar(40) [note: "immediately|within_1_month|within_3_months|just_exploring|custom"]
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  created_at timestamptz
  updated_at timestamptz
}

Table lead_interactions {
  id varchar(36) [pk]
  lead_id varchar(36) [not null]
  counselor_id varchar(36)
  type varchar(20) [not null, note: "call|whatsapp|email|visit|demo|sms|note|stage_change"]
  direction varchar(10) [not null, default: "outbound", note: "inbound|outbound"]
  duration_seconds integer
  summary text
  outcome varchar(20) [note: "positive|neutral|negative|no_answer|callback"]
  ai_sentiment_detected varchar(20)
  recording_url varchar(500)
  created_at timestamptz
}

Table lead_ai_scores {
  id varchar(36) [pk]
  lead_id varchar(36) [not null]
  score integer [not null, note: "0-100"]
  temperature varchar(10) [not null, note: "hot|warm|cold|frozen"]
  score_breakdown json [note: '{"engagement":45,"recency":30,"intent":25}']
  model_version varchar(50) [not null]
  reasoning text
  scored_at timestamptz [not null]
  created_at timestamptz
}

Table lead_stage_recommendations_log {
  id varchar(36) [pk]
  lead_id varchar(36) [not null]
  from_stage varchar(40)
  to_stage varchar(40) [not null]
  confidence float [not null, default: 0.0]
  source varchar(20) [not null, note: "rule|signal|llm"]
  reason text
  signals json
  decision varchar(15) [not null, default: "pending", note: "pending|accepted|overridden|expired"]
  decided_at timestamptz
  decided_by_id varchar(36)
  override_stage varchar(40)
  override_reason text
  model_version varchar(50)
  created_at timestamptz
}

Table lead_attachments {
  id varchar(36) [pk]
  lead_id varchar(36) [not null]
  uploaded_by_id varchar(36)
  category varchar(30) [not null, default: "other", note: "aadhar|passport_photo|payment_screenshot|id_proof|other"]
  filename varchar(255) [not null]
  file_url varchar(500) [not null]
  content_type varchar(100) [not null]
  size_bytes integer [not null, default: 0]
  note text
  created_at timestamptz
}

Table counselor_profiles {
  id varchar(36) [pk]
  user_id varchar(36) [not null, unique]
  conversion_matrix json [not null, default: '{}']
  overall_conversion_rate float [not null, default: 0.0]
  total_leads_handled integer [not null, default: 0]
  total_enrolled integer [not null, default: 0]
  active_lead_count integer [not null, default: 0]
  max_capacity integer [not null, default: 50]
  avg_response_time_hours float
  centres json [not null, note: '["adajan","vesu"]']
  languages json [not null, note: '["hindi","gujarati","english"]']
  narrative_text text
  narrative_embedding json [note: "1536-dim float array for RAG matching"]
  profile_version integer [not null, default: 1]
  last_refreshed_at timestamptz
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table counselor_match_logs {
  id varchar(36) [pk]
  lead_id varchar(36) [not null]
  trigger varchar(30) [not null, note: "lead_created|priya_qualified|manual_request|periodic_reeval"]
  recommended_counselor_id varchar(36) [not null]
  assigned_counselor_id varchar(36)
  match_scores json [not null, note: "[{counselor_id, total_score, breakdown}]"]
  lead_snapshot json
  reasoning text
  was_auto_assigned boolean [not null, default: false]
  was_overridden boolean [not null, default: false]
  override_counselor_id varchar(36)
  override_reason text
  outcome varchar(20) [note: "enrolled|lost|pending"]
  created_at timestamptz [not null]
}

Table campaigns {
  id varchar(36) [pk]
  name varchar(200) [not null]
  description text
  type varchar(50) [default: "email"]
  trigger varchar(50) [note: "lead_captured|payment_done|no_contact_48h|status_changed|score_hot|..."]
  status varchar(20) [not null, default: "draft", note: "draft|active|paused|archived"]
  target_segment json
  target_audience json
  content text
  subject varchar(200)
  max_entries_per_lead integer [default: 1, note: "1=once per lead, 0=unlimited"]
  re_entry_days integer
  exit_on_enroll boolean [default: true]
  exit_on_reply boolean [default: false]
  scheduled_at timestamptz
  sent_count integer [default: 0]
  delivered_count integer [default: 0]
  open_count integer [default: 0]
  click_count integer [default: 0]
  conversion_count integer [default: 0]
  created_by varchar(36)
  created_at timestamptz
  updated_at timestamptz
}

Table campaign_steps {
  id varchar(36) [pk]
  campaign_id varchar(36) [not null]
  step_order integer [not null]
  delay_hours integer [not null, default: 0]
  channel varchar(20) [not null, note: "whatsapp|email|sms|counselor_alert"]
  template_content text [not null]
  is_ai_generated boolean [default: false]
  ab_test_variant varchar(5)
  condition_type varchar(30) [default: "always", note: "always|if_opened|if_replied|if_converted|if_not_opened"]
  condition_delay_hours integer [default: 0]
  ai_personalize boolean [default: false]
  personalization_prompt text
  condition_if_opened_id varchar(36)
  condition_if_converted_id varchar(36)
  created_at timestamptz
}

Table campaign_executions {
  id varchar(36) [pk]
  campaign_id varchar(36) [not null]
  lead_id varchar(36)
  student_id varchar(36)
  current_step_index integer [default: 0]
  status varchar(20) [not null, default: "active", note: "active|paused|completed|cancelled|failed"]
  started_at timestamptz
  completed_at timestamptz
  next_step_at timestamptz
  steps_completed json
  exec_data json
  created_at timestamptz
}

Table campaign_step_results {
  id varchar(36) [pk]
  execution_id varchar(36) [not null]
  step_id varchar(36) [not null]
  executed_at timestamptz
  channel varchar(20) [not null]
  status varchar(20) [not null, default: "sent", note: "sent|delivered|failed|skipped"]
  message_sent text
  delivery_status varchar(30)
  opened_at timestamptz
  replied_at timestamptz
  converted boolean [default: false]
  error text
  ab_variant varchar(5)
  created_at timestamptz
}

Table chat_messages {
  id varchar(36) [pk]
  lead_id varchar(36) [not null]
  direction varchar(10) [not null, note: "inbound|outbound"]
  message_type varchar(20) [not null, default: "text", note: "text|image|document|audio|video|location|button|ai|template"]
  body text
  whatsapp_message_id varchar(100) [note: "Meta WA message ID"]
  status varchar(20) [not null, default: "sent", note: "sent|delivered|read|failed"]
  sent_by_user_id varchar(36)
  ai_model varchar(50)
  ai_confidence float
  template_name varchar(100)
  created_at timestamptz
}

Table ai_conversations {
  id varchar(36) [pk]
  lead_id varchar(36) [not null, unique]
  conversation_state varchar(30) [not null, default: "greeting", note: "greeting|qualifying|nurturing|closing|enrolled|lost"]
  last_ai_reply text
  enrichment_data json [note: '{"course_interest":"Python","budget_mentioned":15000}']
  ai_suggestions json
  message_count integer [default: 0]
  last_message_at timestamptz
  auto_reply_enabled boolean [default: true]
  dnd boolean [default: false, note: "Do not disturb — stop auto-replies"]
  created_at timestamptz
  updated_at timestamptz
}

Table counselor_tasks {
  id varchar(36) [pk]
  lead_id varchar(36) [not null]
  counselor_id varchar(36) [not null]
  assigned_by varchar(36)
  task_type varchar(30) [not null, default: "follow_up", note: "follow_up|call_back|send_info|schedule_demo|visit_reminder|payment_followup|custom"]
  custom_label varchar(200)
  description text
  due_date timestamptz [not null]
  completed_at timestamptz
  status varchar(20) [not null, default: "pending", note: "pending|done|cancelled"]
  created_at timestamptz
  updated_at timestamptz
}

Table prompt_versions {
  id varchar(36) [pk]
  name varchar(100) [not null]
  system_prompt text [not null]
  version integer [not null, default: 1]
  is_active boolean [not null, default: false]
  created_by varchar(36)
  description text
  created_at timestamptz
  updated_at timestamptz
}


// ============================================================
// GROUP 3: Learning
// ============================================================

Table tracks {
  id varchar(100) [pk, note: "Slug-style IDs e.g. meta-ads"]
  name varchar(200) [not null]
  slug varchar(200) [unique]
  category varchar(100) [not null, default: "general"]
  description text
  price integer [not null, default: 0]
  price_inr integer
  discounted_price_inr integer
  emi_price integer
  duration varchar(50) [note: "e.g. '12 weeks' — backward compat"]
  duration_weeks integer
  duration_days integer
  difficulty varchar(20) [note: "beginner|intermediate|advanced"]
  delivery_mode varchar(20) [note: "in_person|online|hybrid"]
  centre varchar(20) [note: "adajan|vesu|bhestan"]
  status varchar(20) [not null, default: "active", note: "draft|active|archived"]
  language varchar(10) [not null, default: "en"]
  demand_level varchar(30)
  income_range varchar(50)
  freelance_income varchar(50)
  modules_count integer [default: 0]
  tools json
  ai_curriculum json
  thumbnail_url varchar(500)
  featured boolean [default: false]
  priority varchar(10)
  students integer [default: 0]
  placement_rate integer [default: 0]
  placement_rate_float float
  avg_salary_inr integer
  is_active boolean [default: true]
  created_by varchar(36)
  created_at timestamptz
  updated_at timestamptz
}

Table modules {
  id varchar(36) [pk]
  track_id varchar(100) [not null]
  name varchar(200) [not null]
  title varchar(200)
  description text
  order_index integer [not null]
  duration_minutes integer
  duration_hours float
  learning_outcomes json
  is_ai_generated boolean [default: false]
  is_active boolean [default: true]
  created_at timestamptz
  updated_at timestamptz
}

Table sub_modules {
  id varchar(36) [pk]
  module_id varchar(36) [not null]
  title varchar(200) [not null]
  description text
  order_index integer [default: 1]
  content_type varchar(20) [default: "text", note: "text|video|mixed"]
  content_body text
  video_url varchar(500)
  duration_minutes integer
  quiz_questions json [note: "[{question, options, correct_answer, explanation}]"]
  resources json [note: "[{title, url, type}]"]
  is_active boolean [default: true]
  created_at timestamptz
  updated_at timestamptz
}

Table milestones {
  id varchar(36) [pk]
  module_id varchar(36) [not null, unique]
  badge_name varchar(100) [not null, note: "e.g. HTML Master"]
  badge_icon varchar(50)
  xp_reward integer [default: 100]
  celebration_message text
  is_active boolean [default: true]
}

Table tasks {
  id varchar(36) [pk]
  module_id varchar(36) [not null]
  name varchar(200) [not null]
  description text
  order_index integer [not null]
  grading_rubric json
  max_score integer [default: 100]
  submission_type varchar(20) [default: "file"]
}

Table enrollments {
  id varchar(36) [pk]
  user_id varchar(36) [not null]
  student_id varchar(36)
  track_id varchar(100) [not null]
  batch_id varchar(36)
  payment_id varchar(36)
  status varchar(20) [not null, default: "active", note: "active|completed|dropped|paused|transferred"]
  plan_tier varchar(20) [default: "kit"]
  enrolled_by varchar(36)
  fee_paid integer
  delivery_mode varchar(20) [note: "in_person|online|hybrid"]
  start_date date
  expected_end_date date
  enrolled_at timestamptz
  completed_at timestamptz
  progress_percent float [default: 0.0]
  completion_percentage float [default: 0.0]
  current_module integer [default: 1]
  xp integer [default: 0]
  streak_days integer [default: 0]
  last_activity timestamptz
  freeze_count integer [not null, default: 1]
  freezes_used_this_week integer [not null, default: 0]
  freezes_week_reset_at timestamptz
  paused_at timestamptz
  paused_until timestamptz
  certificate_url varchar(500)
  certificate_id varchar(50) [unique]
  dropout_risk_score integer [note: "0-100"]
  dropout_risk_updated_at timestamptz
  seen_at timestamptz [note: "First view in portal — drives one-time welcome banner"]
  created_at timestamptz
  updated_at timestamptz
}

Table progress_records {
  id varchar(36) [pk]
  enrollment_id varchar(36) [not null]
  module_id varchar(36) [not null]
  status varchar(20) [not null, default: "not_started", note: "not_started|in_progress|completed"]
  completion_percentage float [default: 0.0]
  time_spent_minutes integer [default: 0]
  last_accessed timestamptz
  completed_at timestamptz
  created_at timestamptz
  updated_at timestamptz
}

Table sub_module_progress {
  id varchar(36) [pk]
  enrollment_id varchar(36) [not null]
  sub_module_id varchar(36) [not null]
  status varchar(20) [default: "not_started", note: "not_started|in_progress|completed"]
  quiz_score integer [note: "0-100"]
  quiz_passed boolean
  completed_at timestamptz
}

Table earned_milestones {
  id varchar(36) [pk]
  enrollment_id varchar(36) [not null]
  milestone_id varchar(36) [not null]
  earned_at timestamptz
}

Table resources {
  id varchar(36) [pk]
  module_id varchar(36)
  track_id varchar(100)
  title varchar(200) [not null]
  description text
  resource_type varchar(20)
  url varchar(500)
  download_count integer [default: 0]
  is_public boolean [default: false]
  created_at timestamptz
}

Table certificates {
  id varchar(36) [pk]
  user_id varchar(36) [not null]
  enrollment_id varchar(36) [not null]
  track_id varchar(100) [not null]
  certificate_number varchar(50) [unique]
  final_score integer
  grade_letter varchar(5)
  pdf_url varchar(500)
  verification_url varchar(500)
  issued_at timestamptz
}

Table grades {
  id varchar(36) [pk]
  submission_id varchar(36) [not null, unique]
  score integer [not null]
  max_score integer [default: 100]
  grade_letter varchar(5)
  feedback text
  strengths json
  improvements json
  next_steps text
  graded_by varchar(20) [default: "ai"]
  reviewer_id varchar(36)
  created_at timestamptz
}


// ============================================================
// GROUP 4: Students
// ============================================================

Table students {
  id varchar(36) [pk]
  user_id varchar(36) [not null, unique]
  phone varchar(15)
  date_of_birth date
  city varchar(100)
  state varchar(100)
  qualification varchar(200)
  career_goal text
  preferred_language varchar(5) [not null, default: "hi", note: "en|hi|gu|ta|te|mr"]
  learning_style varchar(20) [note: "visual|reading|practical|mixed"]
  weekly_hours_available integer
  streak_days integer [not null, default: 0]
  last_active timestamptz
  created_at timestamptz
  updated_at timestamptz
}

Table learner_profile_deep {
  id varchar(36) [pk]
  student_id varchar(36) [not null, unique]
  career_goal text
  career_goal_structured json [note: '{"role","industry","salary_target_inr","timeline_months"}']
  current_skill_level json [note: '{"self_rated":"beginner|intermediate|advanced","areas":[...]}']
  learning_style varchar(20) [note: "visual|reading|practical|mixed"]
  daily_hours_available float
  preferred_time varchar(20) [note: "morning|afternoon|evening|night|flexible"]
  device_primary varchar(20) [note: "smartphone|laptop|tablet|desktop"]
  internet_quality varchar(20) [note: "high_speed|moderate|slow|offline_needed"]
  language_preference varchar(5) [not null, default: "hi"]
  motivation_type varchar(30) [note: "job|salary_hike|freelance|business|skill|certificate"]
  biggest_challenge text
  prior_course_experience boolean [default: false]
  has_laptop boolean [default: true]
  onboarding_completed boolean [default: false]
  onboarding_completed_at timestamptz
  kai_conversation_count integer [default: 0]
  last_ai_path_generated_at timestamptz
  created_at timestamptz
  updated_at timestamptz
}

Table student_learning_paths {
  id varchar(36) [pk]
  student_id varchar(36) [not null]
  enrollment_id varchar(36) [not null]
  path_data json [not null, note: "Week-by-week AI study plan"]
  personalization_notes text
  is_active boolean [default: true]
  generated_at timestamptz
  created_at timestamptz
}

Table student_notes {
  id varchar(36) [pk]
  student_id varchar(36) [not null]
  module_id varchar(36) [not null]
  content text
  updated_at timestamptz
  created_at timestamptz
}

Table achievements {
  id varchar(36) [pk]
  user_id varchar(36) [not null]
  badge_id varchar(50) [not null]
  badge_name varchar(100) [not null]
  badge_emoji varchar(10)
  xp_awarded integer [default: 0]
  earned_at timestamptz
}

Table badge_catalog {
  slug varchar(50) [pk]
  name varchar(100) [not null]
  emoji varchar(10) [not null]
  description text
  category varchar(50) [not null, default: "Progress"]
  rarity varchar(20) [not null, default: "common", note: "common|rare|epic|legendary"]
  xp_reward integer [not null, default: 50]
  trigger_type varchar(40) [note: "submission_first|streak_n|score_perfect|track_complete|community_n|referral_n|speed_burst"]
  trigger_threshold integer
  display_order integer [not null, default: 100]
  is_active boolean [not null, default: true]
  created_at timestamptz
  updated_at timestamptz
}

Table level_config {
  level integer [pk]
  xp_required integer [not null]
  reward_label varchar(200) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz
  updated_at timestamptz
}

Table xp_rule {
  source_key varchar(40) [pk, note: "tasks|quiz|community|streak|attendance|badges"]
  display_name varchar(80) [not null]
  display_color varchar(20) [not null, default: "#6B7280"]
  formula_type varchar(40) [not null, note: "submission_count_plus_score|per_completed_lesson|sum_achievement_xp|community_posts_replies|max_streak_days|days_active_buckets"]
  unit_value integer [not null, default: 0]
  base_value integer [not null, default: 0]
  display_order integer [not null, default: 100]
  is_active boolean [not null, default: true]
  created_at timestamptz
  updated_at timestamptz
}

Table referral_commissions {
  id varchar(36) [pk]
  referrer_id varchar(36) [not null]
  referred_id varchar(36) [not null]
  payment_id varchar(36)
  commission_amount numeric(10,2) [not null]
  status varchar(20) [default: "pending"]
  paid_at timestamptz
  created_at timestamptz
}

Table audit_responses {
  id varchar(36) [pk]
  user_id varchar(36) [not null]
  payment_id varchar(36)
  answers json [not null]
  career_score integer
  matched_tracks json
  matched_bundle json
  income_3m varchar(50)
  income_6m varchar(50)
  created_at timestamptz
}


// ============================================================
// GROUP 5: Assessment
// ============================================================

Table assessments {
  id varchar(36) [pk]
  module_id varchar(36)
  track_id varchar(100)
  created_by varchar(36)
  title varchar(200) [not null]
  type varchar(30) [not null, default: "module_quiz", note: "module_quiz|final_assessment|practice|proctored"]
  pass_score integer [not null, default: 60]
  max_attempts integer [not null, default: 2]
  time_limit_minutes integer
  instructions text
  shuffle_questions boolean [not null, default: true]
  show_answers_after boolean [not null, default: true]
  grading_mode varchar(20) [not null, default: "ai_primary", note: "ai_primary|human_primary|hybrid"]
  status varchar(20) [not null, default: "draft", note: "draft|published"]
  total_marks integer [not null, default: 0]
  rubric json
  rubric_generated_by varchar(20) [not null, default: "none", note: "manual|ai|none"]
  rubric_version integer [not null, default: 0]
  published_at timestamptz
  deleted_at timestamptz
  is_active boolean [default: true]
  created_at timestamptz
  updated_at timestamptz
}

Table questions {
  id varchar(36) [pk]
  assessment_id varchar(36) [not null]
  source_question_bank_id varchar(36)
  text text [not null]
  type varchar(20) [not null, default: "mcq", note: "mcq|subjective|true_false|match"]
  options json
  correct_answer text
  explanation text
  marks integer [not null, default: 1]
  order_index integer [not null, default: 0]
  hint text
  ideal_answer_length_words integer
  is_active boolean [not null, default: true]
  created_at timestamptz
  updated_at timestamptz
}

Table question_bank {
  id varchar(36) [pk]
  track_id varchar(100) [not null]
  module_id varchar(36)
  created_by varchar(36)
  text text [not null]
  type varchar(20) [not null, default: "mcq", note: "mcq|subjective|true_false|match"]
  options json
  correct_answer text
  explanation text
  marks integer [not null, default: 1]
  hint text
  ideal_answer_length_words integer
  tags json
  difficulty varchar(20) [note: "easy|medium|hard"]
  usage_count integer [not null, default: 0]
  avg_discrimination_index float
  is_active boolean [not null, default: true]
  created_at timestamptz
  updated_at timestamptz
}

Table submissions {
  id varchar(36) [pk]
  user_id varchar(36) [not null]
  task_id varchar(36)
  enrollment_id varchar(36)
  assessment_id varchar(36)
  submission_text text
  submission_url varchar(500)
  file_url varchar(500)
  file_name varchar(200)
  attempt_number integer [not null, default: 1]
  status varchar(30) [not null, default: "submitted", note: "in_progress|submitted|grading|graded|grading_failed|pending_manual_review|disputed"]
  total_score float
  grade varchar(5) [note: "A|B|C|D|F"]
  submitted_at timestamptz
  graded_at timestamptz
  graded_by varchar(20) [note: "ai|human|ai_human"]
  time_taken_seconds integer
  plagiarism_flag boolean [default: false]
  plagiarism_score float
  created_at timestamptz
  updated_at timestamptz
}

Table answers {
  id varchar(36) [pk]
  submission_id varchar(36) [not null]
  question_id varchar(36) [not null]
  student_answer text
  selected_option integer
  is_correct boolean
  marks_awarded float
  created_at timestamptz
}

Table ai_grading_results {
  id varchar(36) [pk]
  answer_id varchar(36) [not null, unique]
  score float [not null]
  grade varchar(5) [not null]
  feedback text [not null]
  strength_noted text
  improvement_suggestion text
  rubric_breakdown json
  model_used varchar(50) [not null]
  prompt_version varchar(20) [not null]
  tokens_used integer
  latency_ms integer
  human_override_score float
  human_override_by varchar(36)
  human_override_reason text
  created_at timestamptz
}

Table grade_disputes {
  id varchar(36) [pk]
  submission_id varchar(36) [not null]
  question_id varchar(36) [not null]
  user_id varchar(36) [not null]
  reason text [not null]
  status varchar(20) [not null, default: "pending", note: "pending|under_review|resolved|rejected"]
  reviewer_id varchar(36)
  resolution text
  resolved_at timestamptz
  created_at timestamptz
  updated_at timestamptz
}


