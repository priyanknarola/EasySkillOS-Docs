  pricing_tiers
  global_settings
  brand_configs
  system_announcements
  platform_settings
}

TableGroup BatchesAndSessions {
  batches
  batch_enrollments
  sessions
  session_attendance
  live_sessions
}

TableGroup HR {
  staff
  attendance_records
  hubstaff_activities
  integrity_scores
  leave_requests
  leave_balances
  public_holidays
  job_postings
  recruitment_applications
}

TableGroup ParentPortal {
  parent_student_links
  parent_narrative_cache
