  answered_at timestamptz
  created_at timestamptz
}

Table interview_prep_plans {
  id varchar(36) [pk]
  student_id varchar(36) [not null]
  job_listing_id varchar(36) [not null]
  status varchar(20) [not null, default: "generating", note: "generating|ready|failed"]
  company_research_points json
  role_clarity text
