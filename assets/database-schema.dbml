Ref: sub_module_progress.sub_module_id > sub_modules.id
Ref: earned_milestones.enrollment_id > enrollments.id
Ref: earned_milestones.milestone_id > milestones.id
Ref: certificates.user_id > users.id
Ref: certificates.enrollment_id > enrollments.id
Ref: certificates.track_id > tracks.id
Ref: grades.submission_id - submissions.id

// Students
Ref: students.user_id - users.id
Ref: learner_profile_deep.student_id - students.id
Ref: student_learning_paths.student_id > students.id
Ref: student_learning_paths.enrollment_id > enrollments.id
Ref: student_notes.student_id > students.id
Ref: student_notes.module_id > modules.id
Ref: achievements.user_id > users.id
Ref: referral_commissions.referrer_id > users.id
Ref: referral_commissions.referred_id > users.id
Ref: referral_commissions.payment_id > payments.id
Ref: audit_responses.user_id > users.id
Ref: audit_responses.payment_id > payments.id

// Assessment
Ref: assessments.module_id > modules.id
Ref: assessments.track_id > tracks.id
Ref: assessments.created_by > users.id
Ref: questions.assessment_id > assessments.id
Ref: questions.source_question_bank_id > question_bank.id
Ref: question_bank.track_id > tracks.id
Ref: question_bank.module_id > modules.id
Ref: question_bank.created_by > users.id
Ref: submissions.user_id > users.id
Ref: submissions.task_id > tasks.id
Ref: submissions.enrollment_id > enrollments.id
Ref: submissions.assessment_id > assessments.id
Ref: answers.submission_id > submissions.id
Ref: answers.question_id > questions.id
Ref: ai_grading_results.answer_id - answers.id
