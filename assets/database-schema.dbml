Ref: campaign_executions.lead_id > leads.id
Ref: campaign_executions.student_id > users.id
Ref: campaign_step_results.execution_id > campaign_executions.id
Ref: campaign_step_results.step_id > campaign_steps.id
Ref: chat_messages.lead_id > leads.id
Ref: chat_messages.sent_by_user_id > users.id
Ref: ai_conversations.lead_id - leads.id
Ref: counselor_tasks.lead_id > leads.id
Ref: counselor_tasks.counselor_id > users.id
Ref: counselor_tasks.assigned_by > users.id
Ref: prompt_versions.created_by > users.id

// Learning
Ref: tracks.created_by > users.id
Ref: modules.track_id > tracks.id
Ref: sub_modules.module_id > modules.id
Ref: milestones.module_id - modules.id
Ref: tasks.module_id > modules.id
Ref: resources.module_id > modules.id
Ref: resources.track_id > tracks.id
Ref: enrollments.user_id > users.id
Ref: enrollments.student_id > students.id
