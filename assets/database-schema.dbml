  created_at timestamptz
  paid_at timestamptz
}

Table fee_payments {
  id varchar(36) [pk]
  enrollment_id varchar(36) [not null]
  amount numeric(10,2) [not null]
  payment_method varchar(30) [note: "razorpay|upi|cash|bank_transfer|cheque"]
  razorpay_order_id varchar(100)
  razorpay_payment_id varchar(100) [unique]
  razorpay_signature varchar(200)
  status varchar(20) [not null, default: "pending", note: "pending|paid|failed|refunded"]
  paid_at timestamptz
  receipt_url varchar(500)
  notes text
  created_at timestamptz
  updated_at timestamptz
}

Table emi_plans {
  id varchar(36) [pk]
  enrollment_id varchar(36) [not null]
  total_amount numeric(10,2) [not null]
  installments_count integer [not null, default: 3]
  frequency varchar(20) [not null, default: "monthly", note: "weekly|monthly|quarterly"]
  mandate_id varchar(100) [note: "Razorpay mandate/subscription ID"]
  status varchar(20) [not null, default: "active", note: "active|completed|defaulted|cancelled"]
  created_at timestamptz
  updated_at timestamptz
}

Table emi_installments {
  id varchar(36) [pk]
  emi_plan_id varchar(36) [not null]
  installment_number integer [not null]
  amount numeric(10,2) [not null]
  due_date date [not null]
