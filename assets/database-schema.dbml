}

Table job_postings {
  id varchar(36) [pk, note: "HR internal job postings"]
  title varchar(200) [not null]
  department varchar(50) [not null]
  centre varchar(50) [not null]
  employment_type varchar(30) [not null]
  salary_range_min_inr integer
  salary_range_max_inr integer
  description text
  requirements json
  responsibilities json
  status varchar(20) [not null, default: "draft", note: "draft|open|on_hold|closed"]
  closing_date date
  posted_at timestamptz
  created_by varchar(36)
  created_at timestamptz
  updated_at timestamptz
}

Table recruitment_applications {
  id varchar(36) [pk]
  job_id varchar(36) [not null]
  applicant_name varchar(200) [not null]
  email varchar(200)
  phone varchar(20)
  current_company varchar(200)
  current_designation varchar(200)
  notice_period_days integer
  expected_salary_inr integer
  cover_letter text
  resume_url varchar(500)
  status varchar(30) [not null, default: "applied", note: "applied|screening|shortlisted|interview_scheduled|interviewed|offer_sent|hired|rejected"]
  ai_score float [note: "0-100"]
  ai_recommendation varchar(20) [note: "shortlist|consider|reject"]
  ai_screening_result json
  screened_at timestamptz
  offer_letter_url varchar(500)
  offer_expires_at timestamptz
  created_at timestamptz
  updated_at timestamptz
}

// ============================================================
// GROUP 13: Parent Portal
// ============================================================

Table parent_student_links {
  id varchar(36) [pk]
  parent_user_id varchar(36) [not null]
  student_id varchar(36) [not null]
  relationship varchar(20) [not null, default: "guardian", note: "mother|father|guardian"]
  is_primary boolean [not null, default: true]
  consent_given boolean [not null, default: false]
  consent_at timestamptz
  language_preference varchar(5) [not null, default: "hi"]
  parent_name varchar(200)
  parent_phone varchar(20)
  whatsapp_number varchar(20)
  created_at timestamptz
  updated_at timestamptz
}

Table parent_narrative_cache {
  id varchar(36) [pk]
  student_id varchar(36) [not null]
  language varchar(5) [not null, default: "hi"]
  narrative text [not null]
  generated_at timestamptz [not null]
  cache_date date [not null]
}

Table absence_notes {
  id varchar(36) [pk]
  student_id varchar(36) [not null]
  reported_by varchar(36) [not null]
  absence_date date [not null]
  reason text
  notified_faculty boolean [default: false]
  created_at timestamptz
}

// ============================================================
// GROUP 14: Misc / Marketing
// ============================================================

Table bundles {
  id varchar(100) [pk]
  name varchar(200) [not null]
  description text
  emoji varchar(10)
  price integer [not null]
  original_price integer
  discount_pct integer [default: 0]
  track_ids json [not null]
  track_count integer [default: 0]
  target_persona varchar(50)
  tier varchar(20) [note: "starter|growth|pro|elite"]
  is_active boolean [default: true]
  created_at timestamptz
}

Table testimonials {
  id varchar(36) [pk]
  student_name varchar(100) [not null]
  student_avatar varchar(500)
  track_id varchar(100)
  quote text [not null]
  rating integer [default: 5]
  income_before varchar(50)
  income_after varchar(50)
  video_url varchar(500)
  is_featured boolean [default: false]
  is_active boolean [default: true]
  created_at timestamptz
}

Table career_paths {
  id varchar(36) [pk]
  name varchar(200) [not null]
  description text
  icon_emoji varchar(10)
  track_sequence json [note: "Ordered list of track IDs"]
  estimated_months integer
  target_income varchar(50)
  target_persona varchar(50)
  is_active boolean [default: true]
  created_at timestamptz
}

Table faqs {
  id varchar(36) [pk]
  question varchar(500) [not null]
  answer text [not null]
  category varchar(50) [default: "general"]
  order_index integer [default: 0]
  is_active boolean [default: true]
  views_count integer [default: 0]
  created_at timestamptz
  updated_at timestamptz
}

Table feedback {
  id varchar(36) [pk]
  user_id varchar(36)
  type varchar(20) [not null, default: "nps"]
  score integer
  comment text
  page varchar(100)
  created_at timestamptz
}

Table ambassadors {
  id varchar(36) [pk]
  user_id varchar(36)
  name varchar(100) [not null]
  type varchar(20) [not null, default: "ambassador"]
  phone varchar(15)
  email varchar(255)
  social_links json
  status varchar(20) [default: "pending"]
  total_referrals integer [default: 0]
  total_content integer [default: 0]
  total_earnings numeric(10,2) [default: 0]
  approved_at timestamptz
  created_at timestamptz
}

Table ab_test_variants {
  id varchar(36) [pk]
  experiment_name varchar(100) [not null]
  variant varchar(20) [not null, note: "control|variant_a|variant_b"]
  user_id varchar(36)
  session_id varchar(100)
  converted boolean [default: false]
  conversion_value numeric(10,2)
  created_at timestamptz
}

Table waitlist_entries {
  id varchar(36) [pk]
  name varchar(100) [not null]
  phone varchar(15) [not null]
  email varchar(255)
  track_interest varchar(100)
  status varchar(20) [default: "waiting"]
  notified_at timestamptz
  created_at timestamptz
}

Table gifts {
  id varchar(36) [pk]
  code varchar(50) [not null, unique]
  gift_type varchar(30) [not null, default: "discount"]
  track_id varchar(100)
  discount_value integer
  sender_name varchar(100)
  recipient_name varchar(100)
  recipient_email varchar(255)
  message text
  is_redeemed boolean [default: false]
  redeemed_by varchar(36)
  redeemed_at timestamptz
  expires_at timestamptz
  created_at timestamptz
}

Table govt_schemes {
  id varchar(36) [pk]
  name varchar(200) [not null]
  description text
  eligibility text
  benefits text
  apply_link varchar(500)
  deadline timestamptz
  is_active boolean [default: true]
  created_at timestamptz
}

Table blog_posts_legacy {
  id varchar(36) [pk]
  slug varchar(200) [not null, unique]
  title varchar(300) [not null]
  content text [not null]
  excerpt varchar(500)
  author_name varchar(100) [default: "EasySkill Team"]
  category varchar(50)
  tags json
  cover_image_url varchar(500)
  is_published boolean [default: false]
  published_at timestamptz
  views_count integer [default: 0]
  created_at timestamptz
  updated_at timestamptz
}


// ============================================================
// RELATIONSHIPS
// ============================================================

// Auth & Users
Ref: users.manager_id > users.id
Ref: profiles.user_id - users.id
Ref: user_backup_codes.user_id > users.id
Ref: api_keys.created_by_id > users.id

// CRM
Ref: leads.assigned_counselor_id > users.id
Ref: leads.lead_partner_id > users.id
Ref: leads.interested_track_id > tracks.id
Ref: lead_interactions.lead_id > leads.id
Ref: lead_interactions.counselor_id > users.id
